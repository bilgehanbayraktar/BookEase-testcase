{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bookease;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_MIN_32_CHARS_LONG",
    "Issuer": "BookEaseAPI",
    "Audience": "BookEaseClients",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "SeedAdmin": {
    "Email": "admin@yourdomain.com",
    "Password": "YOUR_ADMIN_PASSWORD",
    "FullName": "System Admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
